# Copie este arquivo para .env e preencha com os seus dados.
# O arquivo .env NUNCA vai para o GitHub.
DB_HOST=localhost
DB_PORT=5432
DB_NAME=loja_portal
# Use o usuario so da loja (crie com sql/criar_usuario_loja.sql), nao o "postgres".
DB_USER=loja_app
DB_PASSWORD="coloque_a_senha_do_usuario_da_loja_aqui"
# Banco em OUTRO servidor (nuvem)? Criptografe a conexao: DB_SSLMODE=require
# DB_SSLMODE=

# OBRIGATORIA. O site nao inicia sem ela. Gere com:
#   python -c "import secrets; print(secrets.token_hex(32))"
# e cole o resultado aqui (minimo de 32 caracteres).
SECRET_KEY=""

# Painel administrativo
ADMIN_USUARIO=admin
# Gere o hash rodando: python gerar_hash.py
ADMIN_SENHA_HASH='cole_aqui_o_hash_gerado'

# Loja (opcional)
INSTAGRAM_USUARIO=portal_la.b

# ---------------- Seguranca ----------------
# NO SEU COMPUTADOR (desenvolvimento), coloque FLASK_DEBUG=1.
# NO SERVIDOR, NAO defina FLASK_DEBUG e NAO defina COOKIES_SEGUROS
# (o padrao do servidor ja e seguro: exige HTTPS).
# FLASK_DEBUG=1

# Atras de proxy? nenhum | proxy | cloudflare  (veja o README_SEGURANCA.md)
PROXY_MODO=nenhum

# Anti-robo no checkout (opcional, gratuito). Crie as chaves em
# https://dash.cloudflare.com/?to=/:account/turnstile  (funciona em qualquer hospedagem)
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Servidor de producao (servidor.py)
# HOST=127.0.0.1
# PORT=8000

# Frete automatico (Melhor Envio)
MELHOR_ENVIO_CLIENT_ID=
MELHOR_ENVIO_CLIENT_SECRET=""
# Precisa ser IDENTICO ao endereco de retorno cadastrado no aplicativo
MELHOR_ENVIO_REDIRECT_URI=https://example.com/melhor-envio/callback
MELHOR_ENVIO_AMBIENTE=producao
# CEP de onde voce envia as pecas (so numeros) e e-mail de contato tecnico
CEP_ORIGEM=
CONTATO_API_EMAIL=
